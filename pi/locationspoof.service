# systemd unit for the Raspberry Pi build. pi/install.sh fills in the @...@ placeholders.
[Unit]
Description=LocationSpoof (Raspberry Pi device)
After=usbmuxd.service network-online.target
Wants=network-online.target

[Service]
User=@USER@
WorkingDirectory=@APP_DIR@
Environment=LOCSPOOF_DATA_DIR=@DATA_DIR@
# Optional piezo buzzer on a GPIO pin (BCM numbering), e.g.:
# Environment=LOCSPOOF_BUZZER_PIN=18
ExecStart=@APP_DIR@/.venv/bin/python -m backend.pi --driver auto
# Stopping the service restores the iPhone's real location (the app's normal shutdown).
TimeoutStopSec=20
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
